<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ohmega for Windows: Ohmega.exe for .NET Framework 4.8 (built into every Windows 10 and 11) + ffmpeg.exe next to it.
       Builds on Linux with ./build.sh (dotnet SDK in ~/.dotnet); NuGet fetches the reference assemblies. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Ohmega</AssemblyName>
    <RootNamespace>Ohmega</RootNamespace>
    <ApplicationIcon>Ohmega.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.1</Version>
    <Product>Ohmega</Product>
    <AssemblyTitle>Ohmega</AssemblyTitle>
    <Description>Ohmega — every track, equally loud</Description>
    <Company>Dany161024</Company>
    <Copyright>GPL-3.0 · ohmega.is-my.app</Copyright>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Sources/*.cs" />
    <EmbeddedResource Include="Ohmega.ico" LogicalName="Ohmega.ico" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
